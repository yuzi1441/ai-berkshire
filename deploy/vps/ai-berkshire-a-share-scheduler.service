[Unit]
Description=AI Berkshire unified A-share dashboard scheduler (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/ai-berkshire
Environment=TZ=Asia/Shanghai
EnvironmentFile=-/etc/ai-berkshire/sentiment.env
ExecStart=/usr/local/sbin/ai-berkshire-a-share-scheduler %i
TimeoutStartSec=6h
