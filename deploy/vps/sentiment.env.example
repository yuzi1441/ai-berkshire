# Optional provider token. Anonymous zzshare access is used when left empty.
ZZSHARE_TOKEN=

# Optional OpenAI-compatible remote classifier. If key or model is empty, the
# job uses the built-in lightweight lexicon scorer and labels its confidence.
SENTIMENT_LLM_API_KEY=
SENTIMENT_LLM_MODEL=
SENTIMENT_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
SENTIMENT_LLM_BATCH_SIZE=20
