# Optional provider token. Anonymous zzshare access is used when left empty.
ZZSHARE_TOKEN=

# Required primary classifier. The snapshot is blocked if either this model or
# the independent review model below is not configured.
SENTIMENT_LLM_API_KEY=
SENTIMENT_LLM_MODEL=deepseek-v4-flash
SENTIMENT_LLM_ENDPOINT=https://api.deepseek.com/chat/completions
SENTIMENT_LLM_BATCH_SIZE=20
SENTIMENT_LLM_WORKERS=6
SENTIMENT_LLM_THINKING=disabled
SENTIMENT_LLM_JSON_MODE=true
SENTIMENT_LLM_MAX_TOKENS=1800
SENTIMENT_LLM_TIMEOUT=180

# Required independent review model. Any failure or incomplete response blocks
# the snapshot; the dashboard keeps the last successful snapshot and shows an error.
SENTIMENT_REVIEW_API_KEY=
SENTIMENT_REVIEW_MODEL=
SENTIMENT_REVIEW_ENDPOINT=
SENTIMENT_REVIEW_BATCH_SIZE=20
SENTIMENT_REVIEW_WORKERS=6
SENTIMENT_REVIEW_THINKING=disabled
SENTIMENT_REVIEW_JSON_MODE=true
SENTIMENT_REVIEW_MAX_TOKENS=1800
SENTIMENT_REVIEW_TIMEOUT=180
