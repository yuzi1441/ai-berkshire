# Runtime secrets belong only in /etc/ai-berkshire/sentiment.env on the VPS.
ZZSHARE_TOKEN=

# DeepSeek Official API is the single production model authority.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# News: LOW primary classification; selective HIGH verification.
SENTIMENT_LLM_BATCH_SIZE=8
SENTIMENT_LLM_WORKERS=2
SENTIMENT_LLM_THINKING=enabled
SENTIMENT_LLM_REASONING_EFFORT=low
SENTIMENT_LLM_JSON_MODE=true
SENTIMENT_LLM_MAX_TOKENS=4096
SENTIMENT_LLM_TIMEOUT=600
SENTIMENT_LLM_RETRIES=6
SENTIMENT_LLM_RETRY_BACKOFF=5
SENTIMENT_LLM_MISSING_RESULT_RETRIES=6

SENTIMENT_REVIEW_BATCH_SIZE=4
SENTIMENT_REVIEW_WORKERS=2
SENTIMENT_REVIEW_THINKING=enabled
SENTIMENT_REVIEW_REASONING_EFFORT=high
SENTIMENT_REVIEW_JSON_MODE=true
SENTIMENT_REVIEW_MAX_TOKENS=4096
SENTIMENT_REVIEW_TIMEOUT=600
SENTIMENT_REVIEW_RETRIES=6
SENTIMENT_REVIEW_RETRY_BACKOFF=5
SENTIMENT_REVIEW_MISSING_RESULT_RETRIES=6

# Opportunity: HIGH initial assessment; MAX only for current/near candidates.
OPPORTUNITY_SCAN_REASONING_EFFORT=high
OPPORTUNITY_SCAN_MAX_TOKENS=8192
OPPORTUNITY_SCAN_TIMEOUT=600
OPPORTUNITY_SCAN_RETRIES=3
OPPORTUNITY_VERIFY_REASONING_EFFORT=max
OPPORTUNITY_VERIFY_MAX_TOKENS=12288
OPPORTUNITY_VERIFY_TIMEOUT=600
OPPORTUNITY_VERIFY_RETRIES=3
OPPORTUNITY_DEEP_REASONING_EFFORT=max
OPPORTUNITY_DEEP_MAX_TOKENS=12288
OPPORTUNITY_DEEP_TIMEOUT=600
OPPORTUNITY_DEEP_RETRIES=3

# Cross-module consistency review remains explanatory and uses HIGH.
DECISION_REVIEW_REASONING_EFFORT=high
DECISION_REVIEW_MAX_TOKENS=4096
DECISION_REVIEW_TIMEOUT=600
DECISION_REVIEW_RETRIES=3
