# Optional provider token. Anonymous zzshare access is used when left empty.
ZZSHARE_TOKEN=

# Required primary classifier. DeepSeek scores eligible A-share company news
# and industry auxiliary news. C/D source news is shown but not sent to the model.
SENTIMENT_LLM_API_KEY=
SENTIMENT_LLM_MODEL=deepseek-v4-flash
SENTIMENT_LLM_ENDPOINT=https://api.deepseek.com/chat/completions
SENTIMENT_LLM_BATCH_SIZE=20
SENTIMENT_LLM_WORKERS=6
SENTIMENT_LLM_THINKING=disabled
SENTIMENT_LLM_JSON_MODE=true
SENTIMENT_LLM_MAX_TOKENS=1800
SENTIMENT_LLM_TIMEOUT=600
SENTIMENT_LLM_RETRIES=4
SENTIMENT_LLM_RETRY_BACKOFF=5

# Optional independent review model for A-share news only. If A-share news is
# present, any failure or incomplete response blocks the snapshot. The current
# VPS job runs A-share sentiment only; this model reviews eligible A-share news.
SENTIMENT_REVIEW_API_KEY=
SENTIMENT_REVIEW_MODEL=
SENTIMENT_REVIEW_ENDPOINT=
SENTIMENT_REVIEW_BATCH_SIZE=5
SENTIMENT_REVIEW_WORKERS=6
SENTIMENT_REVIEW_THINKING=disabled
SENTIMENT_REVIEW_JSON_MODE=true
SENTIMENT_REVIEW_MAX_TOKENS=1800
SENTIMENT_REVIEW_TIMEOUT=600
SENTIMENT_REVIEW_RETRIES=4
SENTIMENT_REVIEW_RETRY_BACKOFF=5
