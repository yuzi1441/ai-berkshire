# Optional provider token. Anonymous zzshare access is used when left empty.
ZZSHARE_TOKEN=

# OpenCode Go shared key. The same key is used by the primary and review model.
# Keep this file free of real keys when committing; fill /etc/ai-berkshire/sentiment.env
# on the VPS instead.
OPENCODE_GO_API_KEY=

# Required primary classifier. C/D source news is shown but not sent to the model.
# Direct OpenCode Go API calls use the bare model IDs below.
SENTIMENT_LLM_API_KEY=
SENTIMENT_LLM_MODEL=deepseek-v4-flash
SENTIMENT_LLM_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
# Keep batches and parallelism modest for OpenCode Go's shared gateway.
SENTIMENT_LLM_BATCH_SIZE=8
SENTIMENT_LLM_WORKERS=2
SENTIMENT_LLM_THINKING=disabled
SENTIMENT_LLM_JSON_MODE=true
SENTIMENT_LLM_MAX_TOKENS=4096
SENTIMENT_LLM_TIMEOUT=600
SENTIMENT_LLM_RETRIES=4
SENTIMENT_LLM_RETRY_BACKOFF=5
SENTIMENT_LLM_MISSING_RESULT_RETRIES=3

# Independent review model for A-share news only. It shares the OpenCode Go key
# but uses a different model family. If A-share news is present, any failure or
# incomplete response blocks the snapshot.
SENTIMENT_REVIEW_API_KEY=
SENTIMENT_REVIEW_MODEL=mimo-v2.5-pro
SENTIMENT_REVIEW_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
SENTIMENT_REVIEW_BATCH_SIZE=4
SENTIMENT_REVIEW_WORKERS=2
SENTIMENT_REVIEW_THINKING=disabled
SENTIMENT_REVIEW_JSON_MODE=true
SENTIMENT_REVIEW_MAX_TOKENS=4096
SENTIMENT_REVIEW_TIMEOUT=600
SENTIMENT_REVIEW_RETRIES=4
SENTIMENT_REVIEW_RETRY_BACKOFF=5
SENTIMENT_REVIEW_MISSING_RESULT_RETRIES=3

# Optional cross-module consistency review shown in the dashboard. It reuses
# the primary OpenCode Go key and endpoint when these variables are omitted.
# It never changes the primary judgment or coarse-grained filters.
DECISION_REVIEW_MODEL=deepseek-v4-flash
# DECISION_REVIEW_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
# DECISION_REVIEW_API_KEY=
# DECISION_REVIEW_TIMEOUT=600
# DECISION_REVIEW_RETRIES=4
# DECISION_REVIEW_RETRY_BACKOFF=5
