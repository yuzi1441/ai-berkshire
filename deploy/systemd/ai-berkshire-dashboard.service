[Unit]
Description=AI Berkshire investment dashboard with protected deep-review API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ai-berkshire
Group=ai-berkshire
WorkingDirectory=/srv/ai-berkshire/current
Environment=DASHBOARD_RUNTIME_DIR=/var/lib/ai-berkshire
EnvironmentFile=-/etc/ai-berkshire/sentiment.env
StateDirectory=ai-berkshire
ExecStart=/usr/bin/python3 tools/dashboard_server.py --repo-root /srv/ai-berkshire/current --directory /srv/ai-berkshire/current/site --bind 127.0.0.1 --port 8080
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-berkshire
UMask=0027

[Install]
WantedBy=multi-user.target
