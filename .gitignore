# ===== 系统与工具产物 =====
.DS_Store
__pycache__/
*.pyc
.venv/
.codex/
/tmp/
logs/command-log.jsonl
reports/美团/command-log.jsonl

# 雪球爬虫登录态缓存（含 cookies，本地使用）
/tmp/xueqiu_state.json

# ===== 音视频大文件不入库 =====
# 如确需提交某个文件，用 git add -f 显式加入
*.m4a
*.mp3
*.wav
*.mp4
*.mov

# ===== 公司品牌图：本地生成，不推送 =====
assets/公司品牌图/

# ===== 本地资料区：不打算公开的文件放这个目录，永不入库 =====
# API token（如 FinMind 的 local/finmind_token.txt）也放这里，只留本机
/local/

# Sentiment news pools are runtime caches, not source data.
/data/sentiment/cache/
# Runtime snapshots/cache are reproducible from their source jobs and should
# not become a second committed Source of Truth.
/data/sentiment/snapshots/
/data/sentiment/work-in-progress.json
/data/technical-backtest/cache/

# Dashboard build artifacts are recreated from canonical reports and
# structured Source of Truth during CI/VPS release builds.
/data/investment-dashboard/company_state.json
/data/investment-dashboard/decision_board.json
/data/investment-dashboard/decision_board_summary.json
/data/investment-dashboard/decision_details/
/data/investment-dashboard/checklist_states.json
/data/investment-dashboard/event_radar.json
/data/investment-dashboard/main_report_review.json
/data/investment-dashboard/model_review_comparison.json
/data/investment-dashboard/intraday_technical.json
/data/investment-dashboard/decision_reviews.json
/data/investment-dashboard/opportunity_scans.json
/data/investment-dashboard/post_buy_alerts.json
/data/investment-dashboard/quotes/
/data/investment-dashboard/reports_catalog.json
/data/investment-dashboard/report_history.json
/data/investment-dashboard/technical_latest.json
/logs/technical-analysis-batch-*.json
/data/sentiment/latest.json
/site/data/

# Builder-generated Obsidian indexes; source reports remain tracked.
/reports/00-index/投资决策总表.md
/reports/00-index/报告库-MOC.md

# ===== 密钥/凭证类文件，任何位置一律不入库 =====
.env
.env.*
*_token.txt
*.token

# 组合报告只存本地，不公开
reports/portfolio-latest.md

# 实盘记录/ 公开权重口径版；原始账本（含股数/金额）在 local/实盘记录-原始/（已被 /local/ 规则覆盖）

# Local Obsidian workspace settings
.obsidian/
